---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Wanderburg Guide — Modules, Silver & Captains (0.9.13 EA)';
const description =
  'Player-first Wanderburg Early Access guides: module slot reference, silver Overtime decision tree, and captain × module pairings. Finish runs — no invented DPS or shop prices.';
const ogImage = 'https://wanderburgguide.site/images/og-home.jpg';
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonicalPath="/" shell="wood">
  <div class="home-hero">
    <img
      src="/images/home-hero.webp"
      alt="Wanderburg — castle on wheels rolling through green hills"
      width="1920"
      height="840"
      fetchpriority="high"
    />
    <div class="home-hero-overlay">
      <p class="eyebrow">Master the</p>
      <h1>Mobile Fortress</h1>
      <p class="lead">Build smarter. Command stronger. Wander further.</p>
      <span class="hero-divider" aria-hidden="true"></span>
      <a class="cta-btn thick" href="/best-modules/">Start with modules →</a>
    </div>
  </div>

  <div class="home-wrap">
  <div class="card-grid cards-3">
    <a class="entry-card" href="/best-modules/">
      <img
        class="card-thumb"
        src="/images/ss_36b03816140674eb040db96cec090854044dff5d.1920x1080.jpg"
        alt="Choose New Module screen — Companion, Side Barracks, Front Cannon"
        width="640"
        height="360"
      />
      <div class="card-icon" aria-hidden="true">🧩</div>
      <h2>Module Slot Guide</h2>
      <p>Front, side, top, back — what to mount and unlock→buy chains. Real modules only.</p>
      <div class="card-tag">Beginner to Endgame</div>
      <span class="cta-btn block">Read guide →</span>
    </a>
    <a class="entry-card" href="/silver-farming/">
      <img
        class="card-thumb"
        src="/images/ss_036989f9c5ee7df8dc8dbbbd7f22b5e9109dda31.1920x1080.jpg"
        alt="Camp hub with shop chest — silver and between-run decisions"
        width="640"
        height="360"
      />
      <div class="card-icon icon-silver" aria-hidden="true">📜</div>
      <h2>Silver Decision Tree</h2>
      <p>When to Overtime after four bosses. When to cash out. Quest lumps that pay.</p>
      <div class="card-tag">When to cash out</div>
      <span class="cta-btn block">Explore tree →</span>
    </a>
    <a class="entry-card" href="/captains/">
      <img
        class="card-thumb"
        src="/images/home-captains-thumb.jpg"
        alt="Wanderburg captain cards — Patchy the Pirate, Racer Ruth, Tankbert"
        width="640"
        height="360"
      />
      <div class="card-icon icon-captains" aria-hidden="true">⛑️</div>
      <h2>Captains Pairing</h2>
      <p>Unlock / role / pairing for the EN roster. Pirate → cannons. No fake tiers.</p>
      <div class="card-tag">Find Your Perfect Crew</div>
      <span class="cta-btn block">View pairings →</span>
    </a>
  </div>

  <div class="card-grid cards-3" style="margin-top:1.35rem;">
    <a class="entry-card" href="/bosses/">
      <img
        class="card-thumb"
        src="/images/modules/still-battle-b.jpg"
        alt="Wanderburg boss fight — four bosses gate every land"
        width="1200"
        height="675"
        loading="lazy"
      />
      <div class="card-icon" aria-hidden="true">🏰</div>
      <h2>Bosses Guide</h2>
      <p>Four bosses per land, the unlock chain, and when to fight vs cash out.</p>
      <div class="card-tag">Boss loop</div>
      <span class="cta-btn block">Read bosses →</span>
    </a>
    <a class="entry-card" href="/unlocks/">
      <img
        class="card-thumb"
        src="/images/modules/still-shop-loadout.jpg"
        alt="Wanderburg camp shop — every verified unlock condition"
        width="1200"
        height="675"
        loading="lazy"
      />
      <div class="card-icon icon-silver" aria-hidden="true">🔓</div>
      <h2>Unlock Conditions</h2>
      <p>Front Cannon at side cannons 10, Companion at 120 walking enemies — every verified chain.</p>
      <div class="card-tag">Toast ≠ owned</div>
      <span class="cta-btn block">See unlocks →</span>
    </a>
    <a class="entry-card" href="/achievements/">
      <img
        class="card-thumb"
        src="/images/modules/still-press-field.jpg"
        alt="Wanderburg field fight — all 26 achievements with unlock rates"
        width="1200"
        height="675"
        loading="lazy"
      />
      <div class="card-icon icon-captains" aria-hidden="true">🏆</div>
      <h2>Achievements</h2>
      <p>All 26 with live unlock rates, fastest routes, and the reported desert bug.</p>
      <div class="card-tag">26 achievements</div>
      <span class="cta-btn block">Track them →</span>
    </a>
  </div>

  <section class="guide-section" id="hotfix-0913">
    <h2>Hotfix 0.9.13 (19 Sep) — damage numbers, leaderboard options, Overtime tuning</h2>
    <p>
      Official notes for this one: a <strong>damage-numbers system</strong> was added and can be switched on in the settings tab, the start screen now has an option to <strong>hide the leaderboard</strong>, performance work landed, <strong>Overtime was rebalanced again</strong>, and the bug fixes cover keeping the player inside the map, the Overworld close-biome button, boss spawn positioning and missing DFI fog in the Overworld. Localization placeholders were added for the new options.
    </p>
    <p>
      Two of those change how you read a run: with damage numbers on you can see whether a module build is actually connecting, and any Overtime silver figure you noted before 19 Sep was measured on the older balance.
    </p>
  </section>

  <div class="status-bar" role="contentinfo">
    <span>🛡 Built for Wanderburg players</span>
    <span>🌿 Player-first guides</span>
    <span>⚒ Game-accurate info</span>
    <span class="tagline">Wander bold. Command well.</span>
  </div>

  <p class="meta-note" style="margin-top:1rem;text-align:center;">
    Unofficial · Steam app 3624140 · EA since 8 Sep 2026 · Randwerk / Sidekick Publishing · editorial label 0.9.13
  </p>
  </div>
</BaseLayout>
