---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Wanderburg Guide — Modules, Silver & Captains (0.9.9 EA)';
const description =
  'Player-first Wanderburg Early Access guides: module slot reference, silver Overtime decision tree, and captain × module pairings. Finish runs — no invented DPS or shop prices.';
const ogImage =
  'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3624140/1af8e0906799b8c9063d0e5031571aef48b55605/header_alt_assets_2.jpg';
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonicalPath="/">
  <img
    class="hero-img"
    src={ogImage}
    alt="Wanderburg — castle on wheels Steam header"
    width="1200"
    height="630"
    fetchpriority="high"
  />
  <p class="hero-caption">Finish a run. Spend silver. Unlock the next toy.</p>

  <h1>Wanderburg Guide</h1>
  <p class="lead">
    Castle-on-wheels roguelike. These three pages tell you what to mount, when to cash out, and which captain fits your kit.
  </p>

  <div class="do-now">
    <h2>Do this now</h2>
    <ul>
      <li>Learn the four slots — front, side, top, back — before you buy anything.</li>
      <li>Spend <strong>silver</strong> between runs. In-run <strong>gold</strong> only buys level-ups.</li>
      <li>Clear four bosses, then enter <strong>Overtime</strong> if you still have HP.</li>
      <li>Pair captains to modules (Pirate → cannons; Empress → Companion).</li>
    </ul>
  </div>

  <div class="card-grid cards-3">
    <a class="card" href="/best-modules/">
      <h2>Best Modules</h2>
      <p>Slot chart + what to mount. Unlock → buy chains. Build families.</p>
    </a>
    <a class="card" href="/silver-farming/">
      <h2>Silver Farming</h2>
      <p>When to Overtime. When to cash out. Quests that pay lump silver.</p>
    </a>
    <a class="card" href="/captains/">
      <h2>Captains</h2>
      <p>Unlock / role / pairing. Who warps which module line.</p>
    </a>
  </div>

  <p class="meta-note">
    Unofficial · Steam app 3624140 · EA since 8 Sep 2026 · Randwerk / Sidekick Publishing · editorial label 0.9.9
  </p>
</BaseLayout>
