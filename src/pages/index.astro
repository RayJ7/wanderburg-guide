---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Wanderburg Guide — Modules, Silver & Captains (0.9.9 EA)';
const description =
  'Player-first Wanderburg Early Access guides: module slot reference, silver Overtime decision tree, and captain × module pairings. Finish runs — no invented DPS or shop prices.';
const ogImage = 'https://wanderburgguide.site/images/home-hero.jpg';
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonicalPath="/" shell="wood">
  <div class="home-hero">
    <img
      src="/images/home-hero.jpg"
      alt="Wanderburg — castle on wheels rolling through green hills"
      width="1200"
      height="630"
      fetchpriority="high"
    />
    <div class="home-hero-overlay">
      <h1>Master the Mobile Fortress</h1>
      <p class="lead">Build smarter. Command stronger. Wander further.</p>
      <a class="cta-btn" href="/best-modules/">Start with modules →</a>
    </div>
  </div>

  <div class="card-grid cards-3">
    <a class="entry-card" href="/best-modules/">
      <div class="card-icon" aria-hidden="true">🧩</div>
      <h2>Module Slot Guide</h2>
      <p>Front, side, top, back — what to mount and unlock→buy chains. Real modules only.</p>
      <div class="card-tag">Beginner to Endgame</div>
      <span class="cta-btn block">Read guide →</span>
    </a>
    <a class="entry-card" href="/silver-farming/">
      <div class="card-icon icon-silver" aria-hidden="true">📜</div>
      <h2>Silver Decision Tree</h2>
      <p>When to Overtime after four bosses. When to cash out. Quest lumps that pay.</p>
      <div class="card-tag">When to cash out</div>
      <span class="cta-btn block">Explore tree →</span>
    </a>
    <a class="entry-card" href="/captains/">
      <div class="card-icon icon-captains" aria-hidden="true">⛑️</div>
      <h2>Captains Pairing</h2>
      <p>Unlock / role / pairing for the EN roster. Pirate → cannons. No fake tiers.</p>
      <div class="card-tag">Find Your Perfect Crew</div>
      <span class="cta-btn block">View pairings →</span>
    </a>
  </div>

  <div class="status-bar" role="contentinfo">
    <span>🛡 Built for Wanderburg players</span>
    <span>🌿 Player-first guides</span>
    <span>⚒ Game-accurate info</span>
    <span class="tagline">Wander bold. Command well.</span>
  </div>

  <p class="meta-note" style="margin-top:1rem;text-align:center;">
    Unofficial · Steam app 3624140 · EA since 8 Sep 2026 · Randwerk / Sidekick Publishing · editorial label 0.9.9
  </p>
</BaseLayout>
