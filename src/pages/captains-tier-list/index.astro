---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Wanderburg Captains Tier List (0.9.9 EA)';
const description =
  'Wanderburg captains roster for Early Access 0.9.9: EN main table of 10 plus PT UI names. Role and synergy comparison only — no invented S/A/B ranks. Sources are YouTube stills.';
const ogImage =
  'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3624140/1af8e0906799b8c9063d0e5031571aef48b55605/header_alt_assets_2.jpg';

const enCaptains = [
  {
    name: 'Lumberjack',
    source: '-p5m-EkPUT4',
    role: 'Named on EN roster stills',
    synergy: 'No module-line write-up in our pack yet — identity only',
  },
  {
    name: 'The Count',
    source: '-p5m-EkPUT4',
    role: 'Named on EN roster stills',
    synergy: 'No module-line write-up in our pack yet — identity only',
  },
  {
    name: 'Racer Ruth',
    source: '-p5m-EkPUT4',
    role: 'Named on EN roster stills (speed / mobility flavor by name only)',
    synergy: 'Mobility helps Overtime survival — see Silver farming; no confirmed kit text here',
  },
  {
    name: 'Norbert The Normal',
    source: 'Jeh4-Sdx_3A',
    role: 'Named on EN roster stills',
    synergy: 'No module-line write-up in our pack yet — identity only',
  },
  {
    name: 'Patchy The Pirate',
    source: 'Jeh4-Sdx_3A',
    role: 'Pirate captain line (cannon family)',
    synergy:
      'Reported: +100% cannon damage (enemies too). Warps the cannons + mortar family — see Best modules. Unnamed +30% cannon / +50% taken pick also spoken on tape (may or may not be this captain).',
  },
  {
    name: 'Huntress',
    source: 'Jeh4-Sdx_3A',
    role: 'Named on EN roster stills',
    synergy: 'No verified arrow/turret captain text in our pack — do not invent',
  },
  {
    name: 'Tankbert',
    source: 'tXa2csqQUbA',
    role: 'Named on grind / loadout tape stills',
    synergy: 'Name suggests tank/hull focus; no tooltip dump in sources — identity only',
  },
  {
    name: 'Time Witch',
    source: 'T0vP215Rg_U',
    role: 'Named on EN roster stills',
    synergy: 'No cooldown-kit confirmation in our pack — identity only',
  },
  {
    name: 'Duelist',
    source: 'T0vP215Rg_U',
    role: 'Named on EN roster stills',
    synergy: 'No verified melee/ram link in sources — identity only',
  },
  {
    name: 'Pyromaniac',
    source: 'T0vP215Rg_U',
    role: 'Named on EN roster stills (fire flavor by name only)',
    synergy: 'Fire + ballista family exists on the modules page; no confirmed Pyromaniac kit text here',
  },
];

const ptCaptains = [
  {
    name: 'Kapitalistus Maximus',
    source: 'QoQuTI8CpDQ',
    note: 'Seen on Portuguese UI stills — not folded into the EN main comparison table',
  },
  {
    name: 'Sire Jonah',
    source: 'QoQuTI8CpDQ',
    note: 'Seen on Portuguese UI stills — not folded into the EN main comparison table',
  },
  {
    name: 'Empress',
    source: 'QoQuTI8CpDQ',
    note:
      'PT UI still. Module page evidence (EN tapes): with Companion / Side Barracks — double friendly units + half speed. Needs a back slot for Companion; Spiderberg is the wrong hull. See Best modules → Empress + Companion.',
  },
];
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonicalPath="/captains-tier-list/">
  <h1>Wanderburg Captains Tier List (0.9.9 EA)</h1>

  <blockquote>
    <p>
      <strong>Answer:</strong> There is <strong>no official captains tier list</strong>. This page is a
      <strong>role / synergy comparison</strong> of named captains from Early Access YouTube stills
      (EN main roster of 10). Portuguese UI shows three more names labeled separately. Demo-only Dieter is excluded.
      We do <strong>not</strong> invent S / A / B ranks.
    </p>
  </blockquote>

  <aside class="expectation-banner" role="note" aria-label="Tier list expectation">
    <p>
      <strong>Despite the title keyword “Tier List”:</strong> this page does
      <strong>not</strong> publish S / A / B (or any numeric) tiers. It is a
      <strong>role &amp; synergy comparison</strong> drawn from Early Access sources
      (YouTube stills + sparse ASR) — not a ranked meta sheet.
    </p>
  </aside>

  <p class="meta-note">
    Label: Early Access, editorial target <strong>0.9.9</strong>. Version string not confirmed on Steam news as of 2026-09-12.
    Captains stills are YT frames — caption source video IDs before live image ship; confirm Tier-2 rights.
  </p>

  <h2>What we still can't verify</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Gap</th><th>Status</th></tr>
      </thead>
      <tbody>
        <tr><td>Official S/A/B or balance sheet</td><td><span class="badge badge-hold">None</span> — do not invent ranks</td></tr>
        <tr><td>Full tooltip text for every captain</td><td><span class="badge badge-warn">UNVERIFIED</span> — roster from stills + sparse ASR</td></tr>
        <tr><td>Steam/official captain stills</td><td><span class="badge badge-hold">Missing</span> — image pack is YT-only for captains</td></tr>
        <tr><td>Whether PT-localized names equal unique kits</td><td>Unknown — listed separately, not merged into EN table</td></tr>
        <tr><td>Demo Dieter in EA</td><td>Excluded (demo capture)</td></tr>
      </tbody>
    </table>
  </div>

  <h2>EN main roster (10) — role &amp; synergy</h2>
  <p>
    Filenames and source video IDs come from <code>IMAGE-MAPPING.md</code> (<code>assets/captains/</code>).
    Synergy notes only where the modules / silver cold-reads already cite the line.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Captain</th>
          <th>Role (known)</th>
          <th>Synergy / module link</th>
          <th>YT source</th>
        </tr>
      </thead>
      <tbody>
        {enCaptains.map((c, i) => (
          <tr>
            <td>{i + 1}</td>
            <td><strong>{c.name}</strong></td>
            <td>{c.role}</td>
            <td>{c.synergy}</td>
            <td>
              <a href={`https://www.youtube.com/watch?v=${c.source}`} rel="noopener noreferrer">{c.source}</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Empress &amp; Patchy — module cross-links</h2>
  <ul>
    <li>
      <strong>Patchy The Pirate</strong> → cannon family on
      <a href="/best-modules/">Best modules</a> (Side cannons, Front Cannon, mortar conflict caveats).
      Pirate +100% cannon damage (enemies too) is <em>reported</em>, not a tooltip dump.
    </li>
    <li>
      <strong>Empress</strong> (PT UI still; spoken on EN tapes) → Companion / Side Barracks friendly-unit line on
      <a href="/best-modules/">Best modules</a>. Half-speed tax hurts
      <a href="/silver-farming/">Overtime silver</a> survival — bring mobility (ram / booster / nitro) if you pick her.
    </li>
  </ul>

  <h2>PT UI — not main tier table (3)</h2>
  <p>
    These names appear on Portuguese UI frames (<code>QoQuTI8CpDQ</code>). They are listed for roster completeness
    and language labeling — <strong>not</strong> ranked against the EN table and not treated as a second tier list.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Name</th><th>Note</th><th>YT source</th></tr>
      </thead>
      <tbody>
        {ptCaptains.map((c) => (
          <tr>
            <td><strong>{c.name}</strong></td>
            <td>{c.note}</td>
            <td>
              <a href={`https://www.youtube.com/watch?v=${c.source}`} rel="noopener noreferrer">{c.source}</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Excluded</h2>
  <ul>
    <li><strong>Demo Dieter</strong> — demo capture (<code>oi3HuZHwZ78</code>); out of scope for the EA main table.</li>
  </ul>

  <h2>How to read this page</h2>
  <ol>
    <li>Use it as a <strong>name checklist</strong> against your loadout screen.</li>
    <li>For build value, follow module families on <a href="/best-modules/">Best modules</a> — captains warp those lines, they are not a separate DPS sheet.</li>
    <li>Silver to buy captains / loadout unlocks: <a href="/silver-farming/">Silver farming</a>.</li>
    <li>When Steam or the developer publishes an official roster, replace still-based notes.</li>
  </ol>

  <h2>Version</h2>
  <p>
    Same 0.9.9 editorial caveat as the modules and silver pages. Steam Early Access live since
    <strong>2026-09-08</strong> (appid 3624140). Re-check when Steam News posts a real version number.
  </p>

  <div class="crosslinks">
    <strong>Related:</strong>
    <a href="/best-modules/">Best modules</a> (Empress + Companion, Pirate / cannons) ·
    <a href="/silver-farming/">Silver farming</a> (buy captains between runs) ·
    <a href="/">Home</a>
  </div>

  <div class="changelog">
    <h3>Sources / gaps</h3>
    <ul>
      <li>IMAGE-MAPPING captains section (2026-09-12): EN 10, PT 3, exclude Demo Dieter.</li>
      <li>Module synergy for Pirate / Empress from best-modules cold-read-1 (video ASR).</li>
      <li>No official tier list; no invented S/A/B.</li>
    </ul>
  </div>
</BaseLayout>
