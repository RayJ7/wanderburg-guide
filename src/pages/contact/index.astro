---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Contact — Wanderburg Guide';
const description =
  'Contact the Wanderburg Guide editors. Email placeholder (TODO) for corrections on modules, silver farming, and captains coverage.';
const ogImage =
  'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3624140/1af8e0906799b8c9063d0e5031571aef48b55605/header_alt_assets_2.jpg';
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonicalPath="/contact/">
  <h1>Contact</h1>
  <p class="lead">
    Spotted a wrong unlock, a clearer Steam still, or a captain tooltip we should cite?
    Send a note.
  </p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Channel</th><th>Detail</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>Email</td>
          <td><a href="mailto:contact@example.com">contact@example.com</a> <span class="badge badge-warn">TODO</span> — replace before launch</td>
        </tr>
        <tr>
          <td>Repo</td>
          <td><a href="https://github.com/RayJ7/wanderburg-guide" rel="noopener noreferrer">github.com/RayJ7/wanderburg-guide</a></td>
        </tr>
        <tr>
          <td>Game</td>
          <td><a href="https://store.steampowered.com/app/3624140/Wanderburg/" rel="noopener noreferrer">Steam store</a> · official <a href="https://wanderburg.com/" rel="noopener noreferrer">wanderburg.com</a></td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="meta-note">
    This site is unofficial and not affiliated with Randwerk, Sidekick Publishing, or Valve.
  </p>

  <div class="crosslinks">
    <strong>Guides:</strong>
    <a href="/best-modules/">Best modules</a> ·
    <a href="/silver-farming/">Silver farming</a> ·
    <a href="/captains/">Captains</a>
  </div>
</BaseLayout>
