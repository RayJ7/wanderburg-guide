---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Wanderburg Captains Guide (0.9.9 EA)';
const description =
  'Wanderburg captains unlock, role, and module pairing guide for Early Access 0.9.9. EN roster with captain × module links. No invented S/A/B tiers.';
const ogImage = 'https://wanderburgguide.site/images/home-hero.jpg';

/** Main EN pairing gallery — clean card art (excludes Lumberjack + Huntress; art pending). */
const mainCaptains = [
  {
    name: 'The Count',
    slug: 'TheCount',
    role: 'Healing / sustain',
    pair: 'Reported as more healing. Pair with long Overtime sits and Repair Crew.',
  },
  {
    name: 'Racer Ruth',
    slug: 'RacerRuth',
    role: 'Mobility (by name / pick flavor)',
    pair: 'Speed helps Overtime survival. Strong default when Empress isn’t in play.',
  },
  {
    name: 'Norbert The Normal',
    slug: 'NorbertTheNormal',
    role: 'Default / baseline',
    pair: 'One creator called out “no arrow-related captains” here — safe with any kit.',
  },
  {
    name: 'Patchy The Pirate',
    slug: 'PatchyThePirate',
    role: 'Cannon damage',
    pair: 'Reported: +100% your cannons, +100% enemy cannons. Mount side cannons / Front Cannon / mortar.',
  },
  {
    name: 'Tankbert',
    slug: 'Tankbert',
    role: 'Hull / HP line',
    pair: 'Stills show HP growth on destroying vehicles, with a nitro regen hit. Pair with ram / vehicle-kill routes.',
  },
  {
    name: 'Time Witch',
    slug: 'TimeWitch',
    role: 'Named on EN stills',
    pair: 'No cooldown kit confirmation in our sources — check tooltip before you buy.',
  },
  {
    name: 'Duelist',
    slug: 'Duelist',
    role: 'Named on EN stills',
    pair: 'No verified melee/ram link yet. Ram family players: confirm in loadout.',
  },
  {
    name: 'Pyromaniac',
    slug: 'Pyromaniac',
    role: 'Fire flavor',
    pair: 'Pairs thematically with Fire Crew + Side Ballista. Kit text not dumped — confirm before spending silver.',
  },
];

const pendingArt = [
  {
    name: 'Lumberjack',
    role: 'Starter-flavored pick',
    note: 'Fine as a first captain while you learn slots — card art still rough.',
  },
  {
    name: 'Huntress',
    role: 'Named on EN stills',
    note: 'No verified arrow kit text yet. If you run turrets + arrows, try her — confirm tooltip in loadout.',
  },
];
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonicalPath="/captains/" shell="wood">
  <h1>Captains</h1>
  <p class="lead">
    Unlock and pair legendary captains to lead your crew. EN roster roles + module links — no fake shop prices.
  </p>
  <span class="hero-divider" aria-hidden="true" style="margin:0.35rem auto 1rem;display:block;"></span>

  <div class="captains-layout">
    <div>
      <div class="captain-gallery" role="list">
        {mainCaptains.map((c) => (
          <figure class="captain-card" role="listitem">
            <img
              src={`/images/captains/captain_${c.slug}_clean.jpg`}
              alt={`${c.name} captain card`}
              width="280"
              height="373"
              loading="lazy"
            />
            <figcaption>
              <strong>{c.name}</strong>
              <span class="captain-stars" aria-hidden="true">★★★★★</span>
              <span class="captain-role">{c.role}</span>
              <a class="cta-btn" href={`#pair-${c.slug}`}>
                {c.slug === 'PatchyThePirate' || c.slug === 'Tankbert' || c.slug === 'TheCount' || c.slug === 'Pyromaniac'
                  ? 'Pairing notes →'
                  : 'View guide →'}
              </a>
            </figcaption>
          </figure>
        ))}
      </div>

      <h2>Captain × module pairing</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Captain</th>
              <th>Role</th>
              <th>Pair with</th>
            </tr>
          </thead>
          <tbody>
            {mainCaptains.map((c, i) => (
              <tr id={`pair-${c.slug}`}>
                <td>{i + 1}</td>
                <td><strong>{c.name}</strong></td>
                <td>{c.role}</td>
                <td>{c.pair}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>Key pairings (worth memorizing)</h2>
      <ul>
        <li>
          <strong>Patchy The Pirate → cannons</strong> —
          Side cannons, Front Cannon, mortar family. Enemy cannons also hit harder. Details on
          <a href="/best-modules/">Best modules</a>.
        </li>
        <li>
          <strong>The Count → sustain</strong> —
          Healing talk on tape. Helps long Overtime sits.
        </li>
        <li>
          <strong>Tankbert → vehicle kills / HP</strong> —
          Grow HP bar when you destroy vehicles; nitro regen suffers. Plan mobility elsewhere.
        </li>
      </ul>

      <details class="pending-art">
        <summary>Also in shop — art pending</summary>
        <p class="meta-note">
          Lumberjack and Huntress appear in the between-run shop; card crops are still low quality, so they are not featured in the main gallery or pairing table.
        </p>
        <ul>
          {pendingArt.map((c) => (
            <li>
              <strong>{c.name}</strong> — {c.role}. {c.note}
            </li>
          ))}
        </ul>
      </details>

      <aside class="decision-tree" aria-label="Empress and PT UI captains">
        <h3>Empress (spoken on EN tapes; PT UI still)</h3>
        <p>
          Not in the EN table above. Creators read: <strong>double friendly units</strong>, <strong>half speed</strong>.
          Pair with <strong>Companion</strong> (back slot) or Side Barracks. Skip Spiderberg for Companion runs.
          Half-speed tax hurts Overtime — bring ram / booster / nitro.
        </p>
        <h3>Other PT UI names (not main table)</h3>
        <p>
          Portuguese UI stills also show <strong>Kapitalistus Maximus</strong> and <strong>Sire Jonah</strong>.
          Listed for roster completeness only — not ranked against EN.
        </p>
      </aside>

      <p class="meta-note">Demo Dieter is out of scope for EA.</p>

      <div class="crosslinks">
        <strong>Related:</strong>
        <a href="/best-modules/">Best modules</a> ·
        <a href="/silver-farming/">Silver farming</a> ·
        <a href="/">Home</a>
      </div>

      <details class="still-checking">
        <summary>Still checking</summary>
        <ul>
          <li>No official S/A/B sheet — we will not invent ranks.</li>
          <li>Full tooltip text for every captain — stills + sparse ASR only.</li>
          <li>Whether PT-localized names are unique kits — unknown.</li>
          <li>Cleaner Lumberjack / Huntress crops for main gallery — pending.</li>
          <li>0.9.9 patch string not confirmed on Steam news.</li>
        </ul>
      </details>
    </div>

    <aside class="guide-side" aria-label="Tips">
      <div class="side-panel tips-board">
        <h2>3 Do This Now Tips</h2>
        <ol>
          <li><strong>Unlock early, win early</strong> — buy a captain only after you know your <a href="/best-modules/">module slots</a>.</li>
          <li><strong>Pair for synergy</strong> — Pirate → cannons. Empress → Companion / barracks + accept half speed.</li>
          <li><strong>Level &amp; lead</strong> — farm silver first; captains sit in the between-run shop. <a href="/silver-farming/">Silver farming</a>.</li>
        </ol>
        <p style="font-size:0.78rem;margin:0.75rem 0 0;opacity:0.9;">
          There is no official tier list. Pair by kit, not by letter ranks.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
