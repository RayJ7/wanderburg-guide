---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalPath?: string;
  shell?: 'wood' | 'parchment';
}

const {
  title,
  description,
  ogImage = 'https://wanderburgguide.site/images/home-hero.jpg',
  ogType = 'website',
  canonicalPath = Astro.url.pathname,
  shell = 'wood',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://wanderburgguide.site';
const canonical = `${site}${canonicalPath.endsWith('/') ? canonicalPath : canonicalPath + '/'}`;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Home', icon: '🏠', match: (p: string) => p === '/' },
  { href: '/best-modules/', label: 'Best Modules', icon: '🧩', match: (p: string) => p.startsWith('/best-modules') },
  { href: '/silver-farming/', label: 'Silver Farming', icon: '🪙', match: (p: string) => p.startsWith('/silver-farming') },
  { href: '/captains/', label: 'Captains', icon: '⛑️', match: (p: string) => p.startsWith('/captains') && !p.startsWith('/captains-tier-list') },
  { href: '/contact/', label: 'Contact', icon: '✉', match: (p: string) => p.startsWith('/contact') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Wanderburg Guide" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="4VvWNLXdLgbf9R-BMs8jVNVmam7iCTP1y97Lh3qzptg" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WYX8THXT9W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WYX8THXT9W');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-frame">
        <span class="hdr-rivet tl" aria-hidden="true"></span>
        <span class="hdr-rivet tr" aria-hidden="true"></span>
        <span class="hdr-rivet bl" aria-hidden="true"></span>
        <span class="hdr-rivet br" aria-hidden="true"></span>
        <div class="header-inner">
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">W</span>
            <span class="brand-text">
              Wanderburg
              <span>Game Guide</span>
            </span>
          </a>
          <nav class="nav" aria-label="Primary">
            {nav.map((item) => (
              <a
                href={item.href}
                class="nav-btn"
                aria-current={item.match(path) ? 'page' : undefined}
              >
                <span class="nav-icon" aria-hidden="true">{item.icon}</span>
                <span class="nav-label">{item.label}</span>
              </a>
            ))}
          </nav>
          <div class="chip-row" aria-hidden="true">
            <span class="res-chip gem"><span class="res-ico">◆</span> 2,450</span>
            <span class="res-chip coin"><span class="res-ico">●</span> 18,670</span>
            <span class="chip">EA 0.9.9</span>
          </div>
        </div>
      </div>
    </header>
    <main>
      <div class="page-shell">
        <span class="fs-corner tl" aria-hidden="true"></span>
        <span class="fs-corner tr" aria-hidden="true"></span>
        <span class="fs-corner bl" aria-hidden="true"></span>
        <span class="fs-corner br" aria-hidden="true"></span>
        <span class="fs-edge top" aria-hidden="true"></span>
        <span class="fs-edge bottom" aria-hidden="true"></span>
        <span class="fs-edge left" aria-hidden="true"></span>
        <span class="fs-edge right" aria-hidden="true"></span>
        <div class:list={['page-inner', shell === 'parchment' && 'has-parchment']}>
          <slot />
        </div>
      </div>
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>
          Wanderburg Guide · unofficial fan site ·
          <a href="https://store.steampowered.com/app/3624140/Wanderburg/" rel="noopener noreferrer">Steam</a>
          ·
          <a href="/contact/">Contact</a>
        </p>
        <p>Not affiliated with Randwerk or Sidekick Publishing. No paywalls — player-first guides.</p>
      </div>
    </footer>
  </body>
</html>
