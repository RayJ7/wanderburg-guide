---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalPath?: string;
  shell?: 'wood' | 'parchment';
}

const {
  title,
  description,
  ogImage = 'https://wanderburgguide.site/images/home-hero.jpg',
  ogType = 'website',
  canonicalPath = Astro.url.pathname,
  shell = 'wood',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://wanderburgguide.site';
const canonical = `${site}${canonicalPath.endsWith('/') ? canonicalPath : canonicalPath + '/'}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Wanderburg Guide" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="4VvWNLXdLgbf9R-BMs8jVNVmam7iCTP1y97Lh3qzptg" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WYX8THXT9W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WYX8THXT9W');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          Wanderburg
          <span>Game Guide</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          <a href="/best-modules/" aria-current={path.startsWith('/best-modules') ? 'page' : undefined}>Best Modules</a>
          <a href="/silver-farming/" aria-current={path.startsWith('/silver-farming') ? 'page' : undefined}>Silver Farming</a>
          <a href="/captains/" aria-current={path.startsWith('/captains') && !path.startsWith('/captains-tier-list') ? 'page' : undefined}>Captains</a>
          <a href="/contact/" aria-current={path.startsWith('/contact') ? 'page' : undefined}>Contact</a>
        </nav>
        <div class="chip-row">
          <span class="chip" title="Editorial target; Steam patch string not confirmed">EA 0.9.9</span>
        </div>
      </div>
    </header>
    <main>
      <div class="page-shell">
        <span class="rivet tl" aria-hidden="true"></span>
        <span class="rivet tr" aria-hidden="true"></span>
        <span class="rivet bl" aria-hidden="true"></span>
        <span class="rivet br" aria-hidden="true"></span>
        <div class:list={['page-inner', shell === 'parchment' && 'has-parchment']}>
          <slot />
        </div>
      </div>
    </main>
    <footer class="site-footer">
      <p>
        Wanderburg Guide · unofficial fan site ·
        <a href="https://store.steampowered.com/app/3624140/Wanderburg/" rel="noopener noreferrer">Steam</a>
        ·
        <a href="/contact/">Contact</a>
      </p>
      <p>Not affiliated with Randwerk or Sidekick Publishing. No paywalls — player-first guides.</p>
    </footer>
  </body>
</html>
