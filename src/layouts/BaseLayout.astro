---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalPath?: string;
  shell?: 'wood' | 'parchment';
}

const {
  title,
  description,
  ogImage = 'https://wanderburgguide.site/images/home-hero.jpg',
  ogType = 'website',
  canonicalPath = Astro.url.pathname,
  shell = 'wood',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://wanderburgguide.site';
const canonical = `${site}${canonicalPath.endsWith('/') ? canonicalPath : canonicalPath + '/'}`;
const path = Astro.url.pathname;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Wanderburg Guide" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="4VvWNLXdLgbf9R-BMs8jVNVmam7iCTP1y97Lh3qzptg" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WYX8THXT9W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WYX8THXT9W');
    </script>
  </head>
  <body>
    <header class="site-header site-header-slice">
      <div class="header-slice-wrap">
        <img
          class="header-slice-img"
          src="/images/ui/slices/home/home-header.png"
          width="1280"
          height="71"
          alt="Wanderburg Guide navigation"
        />
        <nav class="header-hotspots" aria-label="Primary">
          <a class="hs hs-home" href="/" aria-current={path === '/' ? 'page' : undefined}><span class="sr-only">Home</span></a>
          <a class="hs hs-modules" href="/best-modules/" aria-current={path.startsWith('/best-modules') ? 'page' : undefined}><span class="sr-only">Best Modules</span></a>
          <a class="hs hs-silver" href="/silver-farming/" aria-current={path.startsWith('/silver-farming') ? 'page' : undefined}><span class="sr-only">Silver Farming</span></a>
          <a class="hs hs-captains" href="/captains/" aria-current={path.startsWith('/captains') && !path.startsWith('/captains-tier-list') ? 'page' : undefined}><span class="sr-only">Captains</span></a>
          <a class="hs hs-contact" href="/contact/" aria-current={path.startsWith('/contact') ? 'page' : undefined}><span class="sr-only">Contact</span></a>
        </nav>
      </div>
    </header>
    <main>
      <div class="page-shell">
        <span class="fs-corner tl" aria-hidden="true"></span>
        <span class="fs-corner tr" aria-hidden="true"></span>
        <span class="fs-corner bl" aria-hidden="true"></span>
        <span class="fs-corner br" aria-hidden="true"></span>
        <span class="fs-edge top" aria-hidden="true"></span>
        <span class="fs-edge bottom" aria-hidden="true"></span>
        <span class="fs-edge left" aria-hidden="true"></span>
        <span class="fs-edge right" aria-hidden="true"></span>
        <div class:list={['page-inner', shell === 'parchment' && 'has-parchment']}>
          <slot />
        </div>
      </div>
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>
          Wanderburg Guide · unofficial fan site ·
          <a href="https://store.steampowered.com/app/3624140/Wanderburg/" rel="noopener noreferrer">Steam</a>
          ·
          <a href="/contact/">Contact</a>
        </p>
        <p>Not affiliated with Randwerk or Sidekick Publishing. No paywalls — player-first guides.</p>
      </div>
    </footer>
  </body>
</html>
