---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalPath?: string;
  shell?: 'wood' | 'parchment' | 'editorial';
}

const {
  title,
  description,
  ogImage = 'https://wanderburgguide.site/images/home-hero.jpg',
  ogType = 'website',
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://wanderburgguide.site';
const canonical = `${site}${canonicalPath.endsWith('/') ? canonicalPath : canonicalPath + '/'}`;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Builds', match: (p: string) => p === '/' },
  { href: '/best-modules/', label: 'Modules', match: (p: string) => p.startsWith('/best-modules') },
  { href: '/captains/', label: 'Captains', match: (p: string) => p.startsWith('/captains') },
  { href: '/silver-farming/', label: 'Silver', match: (p: string) => p.startsWith('/silver-farming') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Wanderburg Guide" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="4VvWNLXdLgbf9R-BMs8jVNVmam7iCTP1y97Lh3qzptg" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WYX8THXT9W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WYX8THXT9W');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">WANDERBURG GUIDE</a>
        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              class="nav-link"
              aria-current={item.match(path) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="page-shell">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>
          Wanderburg Guide · unofficial fan site ·
          <a href="https://store.steampowered.com/app/3624140/Wanderburg/" rel="noopener noreferrer">Steam</a>
          ·
          <a href="/contact/">Contact</a>
        </p>
        <p>Not affiliated with Randwerk or Sidekick Publishing. No paywalls — player-first guides.</p>
      </div>
    </footer>
  </body>
</html>
